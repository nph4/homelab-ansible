[all:vars]
ansible_user='ansible'
ansible_python_interpreter='/usr/bin/python3'
[pis]
pihole.lan
[ubuntu]
# The control container reaches its own host from its Docker network, not the LAN IP (bootstrap.yml key restriction)
nelson-nuc.lan automation_key_from='192.168.88.101,172.16.0.0/12'
quark-vm.lan
kirks-bar.lan
# Docker hosts running a standalone Komodo Periphery (playbooks/komodo-periphery.yml).
# Not nelson-nuc: its Periphery is part of the Core compose project.
[komodo_periphery]
kirks-bar.lan docker_user='kirk'
# Hosts that get Docker Engine + compose v2 from playbooks/docker.yml
[docker:children]
komodo_periphery
nvidia
[docker:vars]
# Account added to the docker group, and that Periphery runs as; set per host once it exists
docker_user='CHANGEME'
# Docker hosts with an NVIDIA GPU (playbooks/nvidia.yml)
[nvidia]
kirks-bar.lan
# Hosts whose containers bind /mnt/nas subdirectories and need a restart when it remounts
# (playbooks/nas-remount-restart.yml). Values are container names, not compose services.
[nas_remount_restart]
nelson-nuc.lan nas_restart_containers='["calibre-web"]'
# crashplan binds /mnt/nas itself with rslave, which covers a late first mount but not a remount
quark-vm.lan nas_restart_containers='["crashplan-pro"]'
kirks-bar.lan nas_restart_containers='["Jellyfin"]'
# Hosts whose labeled database containers are dumped to the NAS nightly (playbooks/db-backup.yml)
[db_backup]
nelson-nuc.lan
quark-vm.lan
kirks-bar.lan
